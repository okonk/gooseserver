{
    // Server tile coordinates are 1-based (the map editor's 0-based + 1).
    // arenaRect is [x, y, width, height]: the floor's bounding box. Only tiles connected
    // to its centre are used, which excludes the stands in the corners.
    "lobbyMap": 57,
    "lobbySpawn": [21, 15],
    "arenaMap": 56,
    "arenaRect": [21, 26, 61, 23],

    "intervalHours": 3,
    "anchorUtc": "00:00",
    "announceMinutes": [15, 10, 5],
    "countdownSeconds": 10,
    "breakSeconds": 15,
    "roundSeconds": 180,
    "timeoutWarningSeconds": 30,
    "stragglerCount": 0,
    "minPlayerDistance": 3,
    "spawnRadius": 7,

    "baseCount": 15,
    "perPlayer": 5,
    "bandSize": 5,
    "bands": [
        { "normals": [461, 462], "boss": 463 }, // Persecutions
        { "normals": [464, 465, 452], "boss": 466 }, // Spooks
        { "normals": [467, 468, 469, 449], "boss": 470 }, // Nagas
        { "normals": [471, 472, 473, 455], "boss": 474 }, // Hay and Fray
        { "normals": [475, 476, 477], "boss": 478 }, // Sewers
        { "normals": [479, 480, 458], "boss": 481 }, // Savages
        { "normals": [482, 483, 450, 453, 459], "boss": 484 }, // Cavern slimes and hares
        { "normals": [485, 486], "boss": 487 }, // Hungry and Paranoid
        { "normals": [488, 489], "boss": 490 }, // Cavern bears and wolves
        { "normals": [491, 492], "boss": 493 }, // Pancakes
        { "normals": [494, 456], "boss": 495 }, // Wraiths
        { "normals": [496, 497], "boss": 498 }, // Giant wraiths
        { "normals": [499, 457], "boss": 500 }, // Young bears
        { "normals": [501, 502], "boss": 503 }, // Ancient warriors
        { "normals": [504, 451], "boss": 505 }, // Simons
        { "normals": [506], "boss": 507 }, // Ancient defenders
        { "normals": [508, 454, 460], "boss": 509 }, // Ancient guards
        { "normals": [510], "boss": 511 }, // Ancient royals
    ],

    "eliteFromRound": 3,
    "eliteChance": 0.05,
    "eliteChanceGrowth": 0.02,
    "eliteChanceMax": 0.30,
    "eliteHpMult": 1.75,
    "eliteDmgMult": 2,
    "eliteTitle": "Elite",
    "eliteTint": [255, 120, 120, 255],

    "bossEvery": 5,
    "bossRoundAddFraction": 0.5,
    "bossHpMult": 10,
    "bossHpPerPlayer": 0.5,
    "bossHpPlayerCurve": 0.5,
    // Boss HP growth, like hpGrowth/hpSoftRound/hpGrowthLate. bossHpGrowth 0 follows normal mobs.
    "bossHpGrowth": 1.35,
    "bossHpSoftRound": 20,
    "bossHpGrowthLate": 1.04,
    "bossDmgMult": 4,

    "minXpSold": 20000000,
    "topXpSold": 5000000000,
    "a": 0,
    "b": 0,
    "anchorRound": 1,
    "anchorMobHp": 15000,
    "anchorMobWeaponDamage": 700,
    "hpGrowth": 1.40,
    "hpSoftRound": 20,
    "hpGrowthLate": 1.15,
    "dmgGrowth": 1.20,
    "dmgSoftRound": 25,
    "dmgGrowthLate": 1.11,
    // Per-kill XP: xpAnchor * xpGrowth per round up to xpSoftRound, xpGrowthLate after it,
    // times the elite or boss multiplier. xpAnchor 0 keeps each template's own XP.
    "xpAnchor": 2000,
    "xpGrowth": 1.14,
    "xpSoftRound": 20,
    "xpGrowthLate": 1.06,
    "eliteXpMult": 2,
    "bossXpMult": 25,

    "currencyId": "arena_coin",
    "roundBase": 1,
    "roundStep": 1,
    "mobBounty": 0,
    "eliteBountyMult": 5,
    "bossBountyMult": 25,
    "killCreditMinShare": 0.40,
    "priestClassIds": [5],
    "priestKillShare": 0.1,
    "milestones": { "5": 10, "10": 20, "15": 30, "20": 50 },

    // Class mobs cast these (template script_params "spells=Name;Name"). damage is a multiple of
    // the mob's normal melee hit against that player, AC applied the same way. heal is a fraction
    // of the healed mob's max HP, used on an arena mob below healBelow. range is in tiles for
    // targeted spells; front shapes (Fearsome Lash etc.) use the spell's own size.
    "mobSpells": {
        "Critical Strike":   { "damage": 4.5, "cooldown": 6 },
        "Fearsome Lash":     { "damage": 4.0, "cooldown": 10 },
        "Spirit Strike":     { "damage": 4.5, "cooldown": 6 },
        "Sunder of Spirits": { "damage": 2.4, "cooldown": 10 },
        "Arcane Blast":      { "damage": 4.5, "cooldown": 6, "range": 5 },
        "Arcane Assault":    { "damage": 2.0, "cooldown": 10, "range": 5 },
        "Frostbite":         { "damage": 2.4, "cooldown": 8, "range": 5 },
        "Restore Health":    { "heal": 0.2, "healBelow": 0.8, "cooldown": 10, "range": 6 },
    },

    // The mayor (an NPC of templateId standing on the arena map) says a random line from each list
    // to the whole map. Placeholders: {round}, {boss}, {player}, {killer}, {count}, {seconds}.
    // "round" and "cleared" fire on roundChance / clearChance of ordinary rounds; the rest always do.
    "mayor": {
        "templateId": 290,
        "roundChance": 0.35,
        "clearChance": 0.35,
        "lines": {
            "start": [
                "Citizens of Minita! Welcome to the arena! Please keep your limbs inside the sand at all times.",
                "Ahem! By the authority vested in me by me, I declare this arena OPEN!",
                "Fighters, the crowd has paid good coin to watch you suffer. Do not disappoint them!",
            ],
            "round": [
                "Round {round}! I've seen tougher fights at the tax office.",
                "Round {round}! Remember, all medical bills are payable to the Mayor's office.",
                "On to round {round}! Somebody wake up the gentleman in row three.",
                "Round {round}! Fight with honour! Or without it, I'm not fussy.",
            ],
            "cleared": [
                "Round {round} cleared! Adequate. Truly, adequate.",
                "Splendid! Round {round} done, and only a little blood on my boots.",
                "Round {round} down! The odds-makers are weeping.",
            ],
            "milestone": [
                "Round {round}! Now THIS is the kind of spectacle I put in the brochure!",
                "{round} rounds survived! I may have to raise ticket prices.",
            ],
            "boss": [
                "Round {round}! Citizens, behold... {boss}! I would say goodbye to your loved ones now.",
                "And now, the moment you've all paid for! I give you... {boss}!",
                "Release {boss}! And somebody fetch a very large mop.",
            ],
            "bossDown": [
                "{boss} has fallen! {player}, the city of Minita thanks you. No, there is no reward.",
                "Unbelievable! {player} has brought down {boss}! Put that on a statue!",
                "{boss} is down! Cleaners, to the sand!",
            ],
            "eliminated": [
                "Oh! {player} is down! Someone check whether they paid their taxes first.",
                "{player} has been flattened by {killer}! The crowd goes mild!",
                "And {player} is out! A moment of silence. Moment over.",
            ],
            "hurry": [
                "{count} left and {seconds} seconds on the clock! Faster, I have a dinner reservation!",
                "Time is running out! The sand is not going to bleed on itself!",
            ],
            "timeout": [
                "Time! That's time! Boo! Refunds will NOT be issued.",
            ],
            "end": [
                "And that's the show! Best effort today: round {round}. Same time next run, citizens!",
                "The games are over! Round {round}! Please exit through the gift shop.",
            ],
        },
    },

    // While a round is being fought a crowd NPC near a random participant shouts at them every
    // everySeconds [min, max]. booChance picks a boo over a cheer; {player} is the participant.
    "crowd": {
        "everySeconds": [8, 18],
        "booChance": 0.35,
        "nearestCrowd": 8,
        "cheers": [
            "GO {player}!",
            "{player}! {player}! {player}!",
            "I've got ten gold on {player}!",
            "We love you {player}!",
            "Smash 'em {player}!",
            "That's my {player}!",
        ],
        "boos": [
            "BOOOO {player}!",
            "My grandmother hits harder than you, {player}!",
            "Get off the sand, {player}!",
            "I want my money back, {player}!",
            "{player} couldn't fight a wet sack!",
        ],
    },

    // Boss mechanics. Each one unlocks at fromRound; leave one out to turn it off. Damage is a
    // multiple of the boss's weapon damage, mitigated by armor like a melee hit. Every warning
    // tile plays animation/animationFile (1 second, re-sent each second of the windup). The boss
    // uses one mechanic every gapSeconds [min, max]; swap and summon run on their own triggers.
    "bossMechanics": {
        "animation": 900001,
        "animationFile": 30022,
        "gapSeconds": [20, 30],
        "slam": { "fromRound": 5, "damage": 3, "radius": 5, "windup": 2 },
        "summon": { "fromRound": 5, "atHp": [0.60], "base": 2, "perPlayers": 3, "shieldAnimation": 900002, "shieldAnimationFile": 30023 },
        "charge": { "fromRound": 15, "damage": 2.5, "length": 8, "windup": 1.5 },
        "mark": { "fromRound": 15, "damage": 4, "size": 3, "windup": 3 },
        "safeZone": { "fromRound": 25, "damage": 6, "blockWidth": 15, "blockHeight": 8, "maxDistance": 20, "windup": 6 },
        "pull": { "fromRound": 25, "range": 8, "windup": 2.5 },
        "swap": { "fromRound": 25, "everySeconds": [45, 60], "windup": 1.5, "lockSeconds": 10, "emote": [1081, 8] },
    },
}
