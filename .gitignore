*.suo
*/bin/*
*/obj/*
*/packages/*
*.sln.ide/*
packages/*
.vs/*
FodyWeavers.xsd
.vscode/
bin/
obj/


.worktrees/

# The sprite atlases, which embed the client's art as base64 PNGs. That art is not this
# repository's to redistribute, so the bundles are built locally and never committed —
# regenerate them with tools/SpriteBundle against a client checkout (tools/README.md).
# This is a licensing boundary, not a size or tidiness one: do not commit them with -f.
tools/DataEditor/sprites-icons.html
tools/DataEditor/sprites-parts.html
tools/DataEditor/sprites-effects.html

# `node tools/DataEditor/build.mjs` output. Every byte of it is derived from sources that
# are either checked in or built locally, and it re-copies the ~4.4 MB of sprite bundles.
tools/DataEditor/dist/

# `node tools/SetBrowser/build.mjs` output. Inlines sprites-parts.html, so the same licensing
# rule as the bundles applies.
tools/SetBrowser/dist/

# clasp's per-spreadsheet script id. The editor is container-bound, so every contributor's
# differs and none of them is canonical.
tools/DataEditor/.clasp.json

# CsvToSql.Console writes this to the current working directory, not the project
# directory, so it must not be anchored to a path.
illutiaData.sql

# Python bytecode from the goose-game-data skill's helper, which is imported directly
# and so drops a __pycache__ next to its source.
*.pyc
__pycache__/

# Working copy of the gws OAuth credentials. gws rewrites its token cache on every API
# call and ~/.config/gws is read-only under the agent sandbox, so the goose-game-data
# skill points GOOGLE_WORKSPACE_CLI_CONFIG_DIR at this directory instead. It holds live
# refresh tokens — never commit it.
.gws/

# Same story for gclasp: it refreshes ~/.clasprc.json in place, so pushes run with
# HOME pointed at this directory and the rc file inside it. Holds live OAuth tokens —
# never commit it.
.gclasp-home/

# local scratch data dumps
.scratch/

# generated boss tracker page
boss_tracker.html
