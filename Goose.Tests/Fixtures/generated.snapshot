TABLE: quests
  COL: class_restrictions BIGINT DEFAULT 0
  COL: description TEXT DEFAULT '' NOT NULL
  COL: fail_text TEXT DEFAULT '' NOT NULL
  COL: id INTEGER PRIMARY KEY
  COL: max_experience BIGINT DEFAULT 0
  COL: max_level INT DEFAULT 0
  COL: min_experience BIGINT DEFAULT 0
  COL: min_level INT DEFAULT 0
  COL: name TEXT NOT NULL
  COL: only_one_player_can_complete CHAR(1) DEFAULT '0'
  COL: pass_text TEXT DEFAULT '' NOT NULL
  COL: prerequisite_quests TEXT DEFAULT '' NOT NULL
  COL: repeatable CHAR(1) DEFAULT '0'
  COL: show_progress CHAR(1) DEFAULT '0'
class_restrictions=253|description=Hey there, if you're looking to follow the\npath of the warrior, I can make you one.\n\nWarriors rely on their HP and strength,\ntanking for the party.\n\nIf raw power and high health interests\nyou, then speak with me.|fail_text=You do not meet the requirements.|id=1|max_experience=0|max_level=5|min_experience=0|min_level=5|name=Path of the Warrior|only_one_player_can_complete=0|pass_text=I have transformed you into a warrior.\nI have given you some items to help you\nalong your journey. Make me proud.|prerequisite_quests=|repeatable=1|show_progress=1
class_restrictions=253|description=Hey there, if you're looking to follow the\npath of the Magus, I can make you one.\n\nMagus rely on their MP and intelligence,\ndoing high damage from a range.\n\nIf high damage with safety and utility\ninterests you, then speak with me.|fail_text=You do not meet the requirements.|id=2|max_experience=0|max_level=5|min_experience=0|min_level=5|name=Path of the Magus|only_one_player_can_complete=0|pass_text=I have transformed you into a Magus.\nI have given you some items to help you\nalong your journey. Make me proud.|prerequisite_quests=|repeatable=1|show_progress=1
class_restrictions=253|description=Hey there, if you're looking to follow the\npath of the Rogue, I can make you one.\n\nRogues rely on doing high damage using a\ncombination of HP and MP and critical\nstrikes.\n\nIf the path of the Rogue interests you,\nthen speak with me.|fail_text=You do not meet the requirements.|id=3|max_experience=0|max_level=5|min_experience=0|min_level=5|name=Path of the Rogue|only_one_player_can_complete=0|pass_text=I have transformed you into a Rogue.\nI have given you some items to help you\nalong your journey. Make me proud.|prerequisite_quests=|repeatable=1|show_progress=1
class_restrictions=253|description=Hey there, if you're looking to follow the\npath of the Priest, I can make you one.\n\nPriests are vital to the survival of a\nparty. They heal and provide buffs.\n\nIf the path of the Priest interests you,\nthen speak with me.|fail_text=You do not meet the requirements.|id=4|max_experience=0|max_level=5|min_experience=0|min_level=5|name=Path of the Priest|only_one_player_can_complete=0|pass_text=I have transformed you into a Priest.\nI have given you some items to help you\nalong your journey. Make me proud.|prerequisite_quests=|repeatable=1|show_progress=1
class_restrictions=0|description=Hello there, adventurer. These mice are\ngetting into everything and eating our\ncrops.\n\nHelp me kill 15 of these darn mice and I\nwill reward you.|fail_text=You do not meet the requirements.|id=5|max_experience=0|max_level=0|min_experience=0|min_level=1|name=Mouse Killer|only_one_player_can_complete=0|pass_text=Thank you for eliminating those pesky\nmice. Take these potions and gold.|prerequisite_quests=|repeatable=0|show_progress=1
class_restrictions=0|description=Hello! These sheep are getting out of\nhand, there are too many of them and I\nneed their wool.\n\nPlease lend a hand and bring me 10 wool.\nYou will be rewarded.|fail_text=You do not meet the requirements.|id=6|max_experience=0|max_level=0|min_experience=0|min_level=2|name=Sheep Wool|only_one_player_can_complete=0|pass_text=Phew! That was hard work. Thank you.\nTake this as payment.|prerequisite_quests=|repeatable=0|show_progress=0
class_restrictions=0|description=Hi there! Brrr. It's cold out here. Please\nbring me 10 rabbit pelts and 10 rabbit fur\nso that I can make a jacket.\n\nBy the way, my friend Jill is out here\nsomewhere. I don't know where she went.\nLet me know where she is so I know she's\nalright.|fail_text=You do not meet the requirements.|id=7|max_experience=0|max_level=0|min_experience=0|min_level=5|name=Jack's Jacket|only_one_player_can_complete=0|pass_text=Much better! Glad to know Jill is alright.\nHere, take these pants.|prerequisite_quests=|repeatable=0|show_progress=1
class_restrictions=0|description=Helppppp! These bunnies are staring at me\nlike they want to kill me. I'm scared.\nPlease kill 20 of them so I get out of\nhere.|fail_text=You do not meet the requirements.|id=8|max_experience=0|max_level=0|min_experience=0|min_level=5|name=Angry Rabbits|only_one_player_can_complete=0|pass_text=Thank you so much! Now I can go and see\nJack!|prerequisite_quests=|repeatable=0|show_progress=1
class_restrictions=0|description=I keep stepping on these damn Asps and\nget bitten by them. Wipe them out. Kill\n20 Asps and you will be rewarded.|fail_text=You do not meet the requirements.|id=9|max_experience=0|max_level=0|min_experience=0|min_level=7|name=Biting Asps|only_one_player_can_complete=0|pass_text=You squashed those Asps. Thank you.|prerequisite_quests=|repeatable=0|show_progress=1
class_restrictions=0|description=Hello there! These bats are driving me\ncrazy with their constant screeching.\nKill 25 of them for me, would you?|fail_text=You do not meet the requirements.|id=10|max_experience=0|max_level=0|min_experience=0|min_level=10|name=Screeching Bats|only_one_player_can_complete=0|pass_text=Muchhhh better! I can finally hear my own\nthoughts. Here take this.|prerequisite_quests=|repeatable=0|show_progress=1
TABLE: spell_effects
  COL: body_a SMALLINT DEFAULT 0 NOT NULL
  COL: body_b SMALLINT DEFAULT 0 NOT NULL
  COL: body_g SMALLINT DEFAULT 0 NOT NULL
  COL: body_id SMALLINT DEFAULT 0 NOT NULL
  COL: body_r SMALLINT DEFAULT 0 NOT NULL
  COL: buff_doesnt_stack_over TEXT DEFAULT '' NOT NULL
  COL: buff_graphic INT DEFAULT 0 NOT NULL
  COL: buff_graphic_file INT DEFAULT 0 NOT NULL
  COL: buff_removable CHAR(1) DEFAULT '1' NOT NULL
  COL: buff_stacks_over TEXT DEFAULT '' NOT NULL
  COL: damage_reduce DECIMAL(9,4) DEFAULT 0 NOT NULL
  COL: do_attack_animation CHAR(1) DEFAULT '0' NOT NULL
  COL: do_cast_animation CHAR(1) DEFAULT '1' NOT NULL
  COL: effect_duration BIGINT DEFAULT 0 NOT NULL
  COL: effect_type INT NOT NULL
  COL: face_id SMALLINT DEFAULT 0 NOT NULL
  COL: hair_a SMALLINT DEFAULT 0 NOT NULL
  COL: hair_b SMALLINT DEFAULT 0 NOT NULL
  COL: hair_g SMALLINT DEFAULT 0 NOT NULL
  COL: hair_id SMALLINT DEFAULT 0 NOT NULL
  COL: hair_r SMALLINT DEFAULT 0 NOT NULL
  COL: haste DECIMAL(9,4) DEFAULT 0 NOT NULL
  COL: hp INT DEFAULT 0 NOT NULL
  COL: hp_change_formula TEXT DEFAULT '0' NOT NULL
  COL: hp_percent_regen DECIMAL(9,4) DEFAULT 0 NOT NULL
  COL: hp_static_regen INT DEFAULT 0 NOT NULL
  COL: max_level_effected INT DEFAULT 50 NOT NULL
  COL: melee_crit DECIMAL(9,4) DEFAULT 0 NOT NULL
  COL: melee_damage DECIMAL(9,4) DEFAULT 0 NOT NULL
  COL: min_level_effected INT DEFAULT 1 NOT NULL
  COL: move_speed SMALLINT DEFAULT 0 NOT NULL
  COL: mp INT DEFAULT 0 NOT NULL
  COL: mp_change_formula TEXT DEFAULT '0' NOT NULL
  COL: mp_percent_regen DECIMAL(9,4) DEFAULT 0 NOT NULL
  COL: mp_static_regen INT DEFAULT 0 NOT NULL
  COL: offeffect_text TEXT DEFAULT '' NOT NULL
  COL: on_attack_spell_chance DECIMAL(5,2) DEFAULT 100 NOT NULL
  COL: on_attack_spell_effect_id INT DEFAULT 0 NOT NULL
  COL: on_hit_spell_chance DECIMAL(5,2) DEFAULT 100 NOT NULL
  COL: on_hit_spell_effect_id INT DEFAULT 0 NOT NULL
  COL: oneffect_text TEXT DEFAULT '' NOT NULL
  COL: only_hits_one_npc CHAR(1) DEFAULT '0' NOT NULL
  COL: random_join_chance DECIMAL(5,2) DEFAULT 0 NOT NULL
  COL: res_air SMALLINT DEFAULT 0 NOT NULL
  COL: res_earth SMALLINT DEFAULT 0 NOT NULL
  COL: res_fire SMALLINT DEFAULT 0 NOT NULL
  COL: res_spirit SMALLINT DEFAULT 0 NOT NULL
  COL: res_water SMALLINT DEFAULT 0 NOT NULL
  COL: script_params TEXT DEFAULT '' NOT NULL
  COL: script_path TEXT DEFAULT '' NOT NULL
  COL: snare_percent DECIMAL(5,2) DEFAULT 0 NOT NULL
  COL: sp INT DEFAULT 0 NOT NULL
  COL: sp_change_formula TEXT DEFAULT '0' NOT NULL
  COL: spell_animation INT DEFAULT 0 NOT NULL
  COL: spell_animation_file INT DEFAULT 0 NOT NULL
  COL: spell_crit DECIMAL(9,4) DEFAULT 0 NOT NULL
  COL: spell_damage DECIMAL(9,4) DEFAULT 0 NOT NULL
  COL: spell_damage_effects CHAR(1) DEFAULT '0' NOT NULL
  COL: spell_display INT DEFAULT 0 NOT NULL
  COL: spell_effect_id INTEGER PRIMARY KEY
  COL: spell_effect_name TEXT NOT NULL
  COL: spell_effected INT NOT NULL
  COL: spell_energy_type INT DEFAULT 0 NOT NULL
  COL: stat_ac SMALLINT DEFAULT 0 NOT NULL
  COL: stat_dex SMALLINT DEFAULT 0 NOT NULL
  COL: stat_int SMALLINT DEFAULT 0 NOT NULL
  COL: stat_sta SMALLINT DEFAULT 0 NOT NULL
  COL: stat_str SMALLINT DEFAULT 0 NOT NULL
  COL: target_size INT DEFAULT 0 NOT NULL
  COL: target_type INT DEFAULT 0 NOT NULL
  COL: taunt_aggro INT DEFAULT 0 NOT NULL
  COL: teleport_map INT DEFAULT 1 NOT NULL
  COL: teleport_x INT DEFAULT 50 NOT NULL
  COL: teleport_y INT DEFAULT 50 NOT NULL
  COL: works_in_pvp CHAR(1) DEFAULT '1' NOT NULL
  COL: works_not_in_pvp CHAR(1) DEFAULT '0' NOT NULL
