TABLE: item_templates
  COL: bindonequip CHAR(1) DEFAULT '0' NOT NULL
  COL: bindonpickup CHAR(1) DEFAULT '0' NOT NULL
  COL: body_state SMALLINT DEFAULT 3 NOT NULL
  COL: class_restrictions BIGINT DEFAULT 0 NOT NULL
  COL: credits_value INT DEFAULT 0 NOT NULL
  COL: event CHAR(1) DEFAULT '0' NOT NULL
  COL: graphic_a SMALLINT DEFAULT 0 NOT NULL
  COL: graphic_b SMALLINT DEFAULT 0 NOT NULL
  COL: graphic_equip SMALLINT DEFAULT 0 NOT NULL
  COL: graphic_file INT DEFAULT 0 NOT NULL
  COL: graphic_g SMALLINT DEFAULT 0 NOT NULL
  COL: graphic_r SMALLINT DEFAULT 0 NOT NULL
  COL: graphic_tile INT NOT NULL
  COL: item_description TEXT DEFAULT '' NOT NULL
  COL: item_name TEXT NOT NULL
  COL: item_slot SMALLINT DEFAULT 20 NOT NULL
  COL: item_template_id INTEGER PRIMARY KEY
  COL: item_type SMALLINT DEFAULT 0 NOT NULL
  COL: item_usetype SMALLINT NOT NULL
  COL: item_value BIGINT DEFAULT 0 NOT NULL
  COL: learn_spell_id INT DEFAULT 0 NOT NULL
  COL: lore CHAR(1) DEFAULT '0' NOT NULL
  COL: max_experience BIGINT DEFAULT 0 NOT NULL
  COL: max_level SMALLINT DEFAULT 0 NOT NULL
  COL: min_experience BIGINT DEFAULT 0 NOT NULL
  COL: min_level SMALLINT DEFAULT 0 NOT NULL
  COL: player_hp INT DEFAULT 0 NOT NULL
  COL: player_mp INT DEFAULT 0 NOT NULL
  COL: player_sp INT DEFAULT 0 NOT NULL
  COL: res_air SMALLINT DEFAULT 0 NOT NULL
  COL: res_earth SMALLINT DEFAULT 0 NOT NULL
  COL: res_fire SMALLINT DEFAULT 0 NOT NULL
  COL: res_spirit SMALLINT DEFAULT 0 NOT NULL
  COL: res_water SMALLINT DEFAULT 0 NOT NULL
  COL: script_params TEXT DEFAULT '' NOT NULL
  COL: script_path TEXT DEFAULT '' NOT NULL
  COL: spell_effect_chance DECIMAL(9,4) DEFAULT 100 NOT NULL
  COL: spell_effect_id INT DEFAULT 0 NOT NULL
  COL: stack_size SMALLINT DEFAULT 1 NOT NULL
  COL: stat_ac SMALLINT DEFAULT 0 NOT NULL
  COL: stat_dex SMALLINT DEFAULT 0 NOT NULL
  COL: stat_int SMALLINT DEFAULT 0 NOT NULL
  COL: stat_sta SMALLINT DEFAULT 0 NOT NULL
  COL: stat_str SMALLINT DEFAULT 0 NOT NULL
  COL: weapon_damage INT DEFAULT 0 NOT NULL
  COL: weapon_delay SMALLINT DEFAULT 10 NOT NULL
