TABLE: npc_templates
  COL: aggro_range SMALLINT DEFAULT 0 NOT NULL
  COL: armor_pierce INT DEFAULT 0 NOT NULL
  COL: attack_range SMALLINT DEFAULT 0 NOT NULL
  COL: attack_speed DECIMAL(9,4) DEFAULT 2 NOT NULL
  COL: body_a SMALLINT DEFAULT 0 NOT NULL
  COL: body_b SMALLINT DEFAULT 0 NOT NULL
  COL: body_g SMALLINT DEFAULT 0 NOT NULL
  COL: body_id SMALLINT DEFAULT 1 NOT NULL
  COL: body_r SMALLINT DEFAULT 0 NOT NULL
  COL: body_state SMALLINT DEFAULT 3 NOT NULL
  COL: class_id SMALLINT DEFAULT 1 NOT NULL
  COL: credit_dealer CHAR(1) DEFAULT '0' NOT NULL
  COL: equipped_items TEXT DEFAULT '0,*,0,*,0,*,0,*,0,*,0,*' NOT NULL
  COL: experience BIGINT DEFAULT 0 NOT NULL
  COL: face_id SMALLINT DEFAULT 0 NOT NULL
  COL: hair_a SMALLINT DEFAULT 0 NOT NULL
  COL: hair_b SMALLINT DEFAULT 0 NOT NULL
  COL: hair_g SMALLINT DEFAULT 0 NOT NULL
  COL: hair_id SMALLINT DEFAULT 0 NOT NULL
  COL: hair_r SMALLINT DEFAULT 0 NOT NULL
  COL: hp_percent_regen DECIMAL(9,4) DEFAULT 0 NOT NULL
  COL: hp_static_regen INT DEFAULT 0 NOT NULL
  COL: invincible CHAR(1) DEFAULT '0' NOT NULL
  COL: move_speed DECIMAL(9,4) DEFAULT 2 NOT NULL
  COL: mp_percent_regen DECIMAL(9,4) DEFAULT 0 NOT NULL
  COL: mp_static_regen INT DEFAULT 0 NOT NULL
  COL: npc_alliance TEXT DEFAULT '' NOT NULL
  COL: npc_facing SMALLINT DEFAULT 3 NOT NULL
  COL: npc_hp INT DEFAULT 0 NOT NULL
  COL: npc_id INTEGER PRIMARY KEY
  COL: npc_level SMALLINT DEFAULT 1 NOT NULL
  COL: npc_mp INT DEFAULT 0 NOT NULL
  COL: npc_name TEXT NOT NULL
  COL: npc_sp INT DEFAULT 0 NOT NULL
  COL: npc_surname TEXT DEFAULT '' NOT NULL
  COL: npc_title TEXT DEFAULT '' NOT NULL
  COL: npc_type SMALLINT DEFAULT 2 NOT NULL
  COL: quest_ids TEXT DEFAULT '' NOT NULL
  COL: res_air SMALLINT DEFAULT 0 NOT NULL
  COL: res_earth SMALLINT DEFAULT 0 NOT NULL
  COL: res_fire SMALLINT DEFAULT 0 NOT NULL
  COL: res_spirit SMALLINT DEFAULT 0 NOT NULL
  COL: res_water SMALLINT DEFAULT 0 NOT NULL
  COL: respawn_time INT DEFAULT 0 NOT NULL
  COL: rootable CHAR(1) DEFAULT '0' NOT NULL
  COL: script_params TEXT DEFAULT '' NOT NULL
  COL: script_path TEXT DEFAULT 'Scripts/NPC/BaseNPC.csx' NOT NULL
  COL: slowable CHAR(1) DEFAULT '0' NOT NULL
  COL: stat_ac SMALLINT DEFAULT 0 NOT NULL
  COL: stat_dex SMALLINT DEFAULT 0 NOT NULL
  COL: stat_int SMALLINT DEFAULT 0 NOT NULL
  COL: stat_sta SMALLINT DEFAULT 0 NOT NULL
  COL: stat_str SMALLINT DEFAULT 0 NOT NULL
  COL: stationary CHAR(1) DEFAULT '0' NOT NULL
  COL: stuck_behaviour SMALLINT DEFAULT 0 NOT NULL
  COL: stuck_timeout INT DEFAULT 20 NOT NULL
  COL: stunnable CHAR(1) DEFAULT '0' NOT NULL
  COL: weapon_damage INT DEFAULT 1 NOT NULL
